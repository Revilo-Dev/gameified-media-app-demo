rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isModerator());
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (
          isModerator() &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "timeoutUntil",
            "updatedAt"
          ])
        ) ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "xp",
          "level",
          "gems",
          "emeralds",
          "casinoCoins",
          "followerCount",
          "followingCount",
          "postCount",
          "updatedAt"
        ])
      );
    }

    match /markets/{marketId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isModerator();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "replyCount",
          "bookmarkCount",
          "reactionCount",
          "averageRating",
          "starRatingCount",
          "rottenTomatoCount",
          "imageURL",
          "imageStoragePath",
          "gifURL",
          "poll",
          "updatedAt"
        ])
      );
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (
          resource.data.parentPostId is string &&
          get(/databases/$(database)/documents/posts/$(resource.data.parentPostId)).data.authorId == request.auth.uid
        ) ||
        (
          resource.data.replyToPostId is string &&
          get(/databases/$(database)/documents/posts/$(resource.data.replyToPostId)).data.authorId == request.auth.uid
        ) ||
        isModerator()
      );
    }

    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorId == request.auth.uid ||
        isModerator()
      );
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorId == request.auth.uid ||
        isModerator()
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && (
        request.resource.data.actorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          resource.data.postId is string &&
          get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorId == request.auth.uid
        ) ||
        isModerator()
      );
    }
  }
}
